#dai li faces screen when movong side to side
def dai_li_angle(e):
    dx = av_x - e["x"] #difference between aang x coord and dai li x coord
    dy = av_y - e["y"] #difference between aang y coord and dai li y coord
    if (dx*dx + dy*dy) ** 0.5 < 250: #if distance between aang and dai li is less than root over x squared plus y squared
        return facing_angle(e["x"], e["y"]) 
    return -90.0 if e["hx"] > 0 else 90.0

