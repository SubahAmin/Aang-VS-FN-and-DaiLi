#dai li faces screen when movong side to side
def dai_li_angle(e):
    dx = av_x - e["x"] #difference between aang x coord and dai li x coord
    dy = av_y - e["y"] #difference between aang y coord and dai li y coord
    if (dx*dx + dy*dy) ** 0.5 < 250: #if distance between aang and dai li is less than root over x squared plus y squared
        return facing_angle(e["x"], e["y"]) 
    return -90.0 if e["hx"] > 0 else 90.0

def draw_hp_bar(e):
    frac = max(0.0, e["hp"] / e["maxhp"])
    glPushMatrix()
    glTranslatef(e["x"], e["y"], 260)
    glColor3f(0.3, 0.3, 0.3)
    glPushMatrix()
    glScalef(100, 6, 10)
    glutSolidCube(1)
    glPopMatrix()
    if frac > 0:
        glColor3f(0.2, 0.9, 0.2)
        glPushMatrix()
        glTranslatef(-50 * (1 - frac), 0, 0)
        glScalef(100 * frac, 7, 11)
        glutSolidCube(1)
        glPopMatrix()
    glPopMatrix()
    
def facing_angle(ex, ey): #so that enemies face aang 
    return math.degrees(math.atan2(-(av_x - ex), av_y - ey))

def has_collided(box1, box2):
    return (box1[0] < box2[0] + box2[2] and
            box1[0] + box1[2] > box2[0] and
            box1[1] < box2[1] + box2[3] and
            box1[1] + box1[3] > box2[1])

def spaced_positions(n=6): #randomly generates 6 unique positions of all enemies so none collide with each other
    positions = []
    while len(positions) < n:
        x = random.randint(-500, 500)
        y = random.randint(-500, 500)
        #checks if all spawn positions do not overlap, approx 160 according to size of enemies
        if all(((x-px)**2 + (y-py)**2)**0.5 >= 160 for px, py in positions):
            positions.append((x, y))
    return positions

def respawn_position():
    for _ in range(200):
        x = random.randint(-500, 500)
        y = random.randint(-500, 500)
        if ((x - av_x)**2 + (y - av_y)**2)**0.5 < 300:
            continue
        if all(((x - e["x"])**2 + (y - e["y"])**2)**0.5 >= 160 for e in enemy_positions):
            return (x, y)
    return (random.randint(-500, 500), random.randint(-500, 500))
        
def draw_text(x, y, text, font=GLUT_BITMAP_HELVETICA_18):
    glColor3f(1,1,1)
    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    
    # Set up an orthographic projection that matches window coordinates
    gluOrtho2D(0, 1000, 0, 800)  # left, right, bottom, top

    
    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()
    
    # Draw text at (x, y) in screen coordinates
    glRasterPos2f(x, y)
    for ch in text:
        glutBitmapCharacter(font, ord(ch))
    
    # Restore original projection and modelview matrices
    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)


