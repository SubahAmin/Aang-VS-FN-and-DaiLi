def keyboardListener(key, x, y):
    """
    Handles keyboard inputs for player movement, gun rotation, camera updates, and cheat mode toggles.
    """
    global av_x, av_y, game_over, air_timer, air_cool, angle, air, fire, earth,firstperson                        #look here fp4
    global avatar_timer, avatar_cool
    
    rad = math.radians(angle)
    ax=-math.sin(rad)
    ay=math.cos(rad)
    active = not game_over and not paused
    if key == b'r':
        reset_game()
        return
    if key == b'w':  
        if active: 
            av_x += 20 * ax
            av_y += 20 * ay

    # # Move backward (S key)
    if key == b's':
        if active: 
            av_x -= 20 * ax
            av_y -= 20 * ay

    #keep aang inside the four walls
    av_x = max(-BOUND, min(BOUND, av_x))
    av_y = max(-BOUND, min(BOUND, av_y))
    av_x, av_y = push_out(av_x, av_y, PLAYER_R) #and outside the pillars

    # # Rotate gun left (A key)
    if key == b'a':
        if active: 
            angle=angle-10

    # # Rotate gun right (D key)
    if key == b'd':
        if active: 
            angle=angle+10
            
    if key in (b'1', b'2', b'3') and avatar_timer > 0:
        print("Avatar state is on, element locked") #nothing can drop the air shield
        return

    if key == b'1':
        if air_timer > 0:
            print("Air shield already up")
        elif air_cool > 0:
            print("Air shield on cooldown")
        else:
            air = True #air shield only, it does not change the element
            air_timer = AIR_TIME
            print("Air shield up")
        
    if key == b'2':
        earth = True
        fire = False
        print("Earth selected")
    if key == b'3':
        fire = True
        earth = False
        print("Fire selected")
     
    if key == b'c':
        if not active:
            pass
        elif avatar_timer > 0:
            print("Avatar state already on")
        elif avatar_cool > 0:
            print("Avatar state on cooldown")
        else:
            avatar_timer = AVATAR_TIME
            air = True #equips the same air shield as key 1, for the same 7 seconds
            air_timer = AVATAR_TIME
            print("Avatar state!")

    if key == b'f':                                                                         #look here fp5
       firstperson = not firstperson
       print("First person mode selected")
        
        

def specialKeyListener(key, x, y):
    """
    Handles special key inputs (arrow keys) for adjusting the camera angle and height.
    """
    global camera_pos,camera_angle 
    x, y, z = camera_pos
    # Move camera up (UP arrow key)
    if key == GLUT_KEY_UP:
        z = z+5

    # # Move camera down (DOWN arrow key)
    if key == GLUT_KEY_DOWN:
        z = z-5
     # moving camera left (LEFT arrow key)
    if key == GLUT_KEY_LEFT:
       camera_angle -= 3 #camera rotates left

    # moving camera right (RIGHT arrow key)
    if key == GLUT_KEY_RIGHT:
        camera_angle += 3 #camera rotates right
        
    radius = 900 #centre set at one point
    rad = math.radians(camera_angle)
    x = radius * math.sin(rad)
    y = radius * math.cos(rad)


    camera_pos = (x, y, z)


def mouseListener(button, state, x, y):
    global bullets, bullet_count, paused

    if button != GLUT_LEFT_BUTTON or state != GLUT_DOWN:
        return

    mx, my = x, 800 - y

    if in_button(mx, my, BTN_BACK):
        reset_game()
        return
    if in_button(mx, my, BTN_PAUSE):
        if game_over:
            print("Please start over")
        else:
            paused = not paused
            print("Paused" if paused else "Played")
        return
    if in_button(mx, my, BTN_EXIT):
        print("Goodbye")
        glutLeaveMainLoop()
        return

    if game_over or paused:
        return

    element = "earth" if earth else "fire" if fire else None
    if element is None:
        return
    spawn_bullets(element)
    bullet_count += 1
