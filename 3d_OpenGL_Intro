def setupCamera():
    """
    Configures the camera's projection and view settings.
    Uses a perspective projection and positions the camera to look at the target.
    """
    global firstperson                                                                        #look here fp2
    glMatrixMode(GL_PROJECTION)  # Switch to projection matrix mode
    glLoadIdentity()  # Reset the projection matrix
    # Set up a perspective projection (field of view, aspect ratio, near clip, far clip)
    gluPerspective(fovY, 1.25, 0.1, 3000) # Think why aspect ration is 1.25?
    glMatrixMode(GL_MODELVIEW)  # Switch to model-view matrix mode
    glLoadIdentity()  # Reset the model-view matrix

    # Extract camera position and look-at target
    x, y, z = camera_pos
    if firstperson :                                                                         #look here fp3
      #  fp_angle = angle
        rad = math.radians(angle) 
        ax = -math.sin(rad)
        ay = math.cos(rad)
        cam_x = av_x +80*ax      #front view through aangs eyes
        cam_y = av_y +80*ay
        cam_z = 170
        gluLookAt(cam_x, cam_y, cam_z,
                  av_x + 400*ax, av_y + 400*ay, 80,
                  0, 0, 1)
        
    else:
    # Position the camera and set its orientation
        gluLookAt(x, y, z,  # Camera position
                 0, 0, 0,  # Look-at target
                 0, 0, 1)  # Up vector (z-axis)


def idle():
    """
    Idle function that runs continuously:
    - Triggers screen redraw for real-time updates.
    """
    global av_x, av_y, air_timer, air_cool, paused, last_time, enemy_positions, bullets, air, game_score, player_hp, enemy_fire, game_over
    global avatar_timer, avatar_cool, avatar_shot, kills, wrong_hits, survived
    
    if paused:
        glutPostRedisplay()
        return
    #time elapsed since the last frame, in seconds
    now = time.perf_counter()
    if last_time == 0:
        last_time = now
    dt = now - last_time
    last_time = now
    if dt > 0.05:
        dt = 0.05
    if not game_over:
        survived += dt #clock only runs while he is alive
        
    #avatar state: counts down, then the cooldown starts
    if avatar_timer > 0:
        air = True #air shield cannot lapse while the state is running
        air_timer = max(air_timer, avatar_timer)
        avatar_timer -= dt
        if avatar_timer <= 0:
            avatar_timer = 0.0
            avatar_cool = AVATAR_COOL
            print("Avatar state over")
        elif not game_over:
            avatar_shot -= dt
            if avatar_shot <= 0: #shoots on its own, no clicking needed
                spawn_bullets("water", True)
                avatar_shot = AVATAR_RATE
    elif avatar_cool > 0:
        avatar_cool = max(0.0, avatar_cool - dt)
        if avatar_cool == 0:
            print("Avatar state ready")

    if air_timer > 0:
        air_timer -= dt
        if air_timer <= 0:
            air_timer = 0
            air = False
            air_cool = AIR_COOL
            print("Air shield expired")
    elif air_cool > 0:
        air_cool = max(0.0, air_cool - dt)
        if air_cool == 0:
            print("Air shield ready")
    
    bullet_speed = 550
    new_bullets = []
    for b in bullets:
        b[0] += b[2] * bullet_speed * dt #x coordinate of bullet being updated
        b[1] += b[3] * bullet_speed * dt #y coordinate of bullet being updated
        if -ARENA <= b[0] <= ARENA and -ARENA <= b[1] <= ARENA: #if bullet goes out of bounds of the arena
            if not in_pillar(b[0], b[1]): #pillars block shots
                new_bullets.append(b)
        
    bullets = new_bullets
    
    speed = 55
    patrol_speed = 90 #speed of dai li
    detect = 250
    
    #enemy movement
    for e in enemy_positions:
        dx = av_x - e["x"] #distance between aang x coord and enemy x coord
        dy = av_y - e["y"] #distance between aang y coord and enemy y coord
        d = (dx*dx + dy*dy) ** 0.5 #total detection range
        #e[immune] names the element that enemy resists,
        #(dx/d, dy/d) normalizes the vector to Aang — dividing by its own length gives a unit vector, same idea as ax, ay. Multiplying by speed steps that far toward him.
        if e["immune"] == "fire" or d < detect: #within range of detection 
            if d > 1:
                e["x"] += (dx/d) * speed * dt #enemy starts moving x and y coord towards aang x y coord
                e["y"] += (dy/d) * speed * dt
            e["cool"] -= dt #firing cooldown of enemies
            if e["cool"] <= 0 and 1 < d < 300 and not game_over:
                ux, uy = dx/d, dy/d
                if e["immune"] == "fire":
                    e["cool"] = 2.5
                    for k in range(4):
                        off = k * 35 #off is the spawn distance for each of the three streak segments: 0, 35, 70, 105
                        enemy_fire.append([e["x"] + ux*off, e["y"] + uy*off,
                                           ux, uy, "fire"])
                else:
                    e["cool"] = 4.0
                    enemy_fire.append([e["x"], e["y"], ux, uy, "earth"])
        else:
            if e["steps"] <= 0:
                e["hx"] = random.choice((-1.0, 1.0)) #e["hx"] is the patrol heading — +1.0 or -1.0, meaning right or left along X.
                e["steps"] = random.uniform(2.0, 5.0)
            e["x"] += e["hx"] * patrol_speed * dt
            e["steps"] -= dt #steps is a countdown. When it expires, pick a fresh random direction and a fresh duration
            if not -930 <= e["x"] <= 930: #boundary of arena for enemy
                e["hx"] = -e["hx"]
                e["x"] = max(-930, min(930, e["x"]))
        #whichever way it moved, keep it out of the pillars so it walks around them
        e["x"], e["y"] = push_out(e["x"], e["y"], ENEMY_R)
    
    
    #enemy bullet movement
    fire_speed = 400
    earth_speed = 240
    aang_box = (av_x - 35, av_y - 35, 70, 70) #coordinate of aang
    surviving_fire = []
    for f in enemy_fire:
        v = fire_speed if f[4] == "fire" else earth_speed #selects speed of bullet depending on enemy
        half = 7 if f[4] == "fire" else 15
        f[0] += f[2] * v * dt #fire x coordinate being updated
        f[1] += f[3] * v * dt #fire y coordinate being updated
        if not (-ARENA <= f[0] <= ARENA and -ARENA <= f[1] <= ARENA):
            continue
        if in_pillar(f[0], f[1]): #pillars block enemy shots too
            continue
        if has_collided((f[0] - half, f[1] - half, half*2, half*2), aang_box):
            if air: #the air shield takes all damage, however it was equipped
                print("Air shield deflected damage") #for element air selected, no damage is done
            else: #damage done by others when not air selected
                player_hp = max(0, player_hp - 2) #hp floors at zero, never negative
                print("Aang hit! HP:", player_hp)
                if player_hp == 0 and not game_over:
                    game_over = True
                    enemy_positions = [] #they vanish, leaving him alone on the ground
                    print("Game over")
            continue
        surviving_fire.append(f)
    enemy_fire = [] if game_over else surviving_fire
    
    
    # bullet vs enemy
    surviving_bullets = []
    for b in bullets:
        half = 17 if b[4] == "earth" else 6 #half is half width of projectile hitbox as point calculated from centre
        bullet_box = (b[0] - half, b[1] - half, half*2, half*2)
        target = None
        best = None
        for e in enemy_positions:
            enemy_box = (e["x"] - EHALF, e["y"] - EHALF, EHALF*2, EHALF*2)
            if has_collided(bullet_box, enemy_box):
                d = (b[0] - e["x"])**2 + (b[1] - e["y"])**2
                if best is None or d < best:
                    best = d
                    target = e
        if target is None:
            surviving_bullets.append(b)
            continue
        if b[4] == target["immune"] and not b[5]:
            wrong_hits += 1
            print("Immune")
        else:
            #an avatar bullet takes the whole health bar, immunity and all
            dmg = target["maxhp"] if b[5] else DAMAGE.get((target["immune"], b[4]), 1)
            target["hp"] -= dmg
            print("Hit for", dmg, "- enemy HP:", target["hp"])
            if target["hp"] <= 0:
                print("Enemy down!")
                kills += 1
                game_score += 10
                target["x"], target["y"] = respawn_position()
                target["hp"] = target["maxhp"]
                target["steps"] = 0
    bullets = [] if game_over else surviving_bullets
    
    # Ensure the screen updates with the latest changes
    glutPostRedisplay()


def showScreen():
    """
    Display function to render the game scene:
    - Clears the screen and sets up the camera.
    - Draws everything of the screen
    """
    # Clear color and depth buffers
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    glLoadIdentity()  # Reset modelview matrix
    glViewport(0, 0, 1000, 800)  # Set viewport size

    setupCamera()  # Configure camera perspective

    # Draw a random points
    glPointSize(20)
    glBegin(GL_POINTS)
    glVertex3f(-GRID_LENGTH, GRID_LENGTH, 0)
    glEnd()

    # Draw the grid (game floor)
    glBegin(GL_QUADS)
    
    glColor3f(0.4, 0.2, 0.1)                   #the floor                                 look here design
    glVertex3f(-ARENA, ARENA, 0)
    glVertex3f(-ARENA, -ARENA, 0)
    glVertex3f(ARENA, -ARENA, 0)
    glVertex3f(ARENA, ARENA, 0)
    
    glColor3f(0.9, 0.6, 0.5)                #the planks
    for i in range (-ARENA, ARENA, 60):
        glVertex3f(i, ARENA, 0)
        glVertex3f(i, -ARENA, 0)
        glVertex3f(i+50, -ARENA, 0)       #width of arena
        glVertex3f(i+50, ARENA, 0)
  
    glEnd()

    # Display game info text at a fixed screen position
    draw_shapes()
    if game_over:
        final = game_score + int(survived) * 2 - wrong_hits * 5
        draw_text(430, 470, "GAME OVER")
        draw_text(410, 430, f"Kills: {kills}")
        draw_text(410, 400, f"Wrong element hits: {wrong_hits}")
        draw_text(410, 370, f"Time survived: {survived:.1f}s")
        draw_text(410, 340, f"Score: {game_score}")
        draw_text(410, 300, f"FINAL SCORE: {final}")
        draw_text(410, 260, "Press R to restart")
    else:
        element = "WATER" if avatar_timer > 0 else "EARTH" if earth else "FIRE" if fire else "NONE"
        draw_text(10, 770, f"HP: {player_hp}")
        draw_text(10, 740, f"Score: {game_score}")
        draw_text(10, 710, f"Element: {element}")
        draw_text(10, 680, f"Kills: {kills}   Wrong hits: {wrong_hits}")
        draw_text(10, 650, f"Time: {survived:.1f}s")
        if avatar_timer > 0:
            draw_text(10, 620, f"AVATAR STATE: {avatar_timer:.1f}s")
        elif avatar_cool > 0:
            draw_text(10, 620, f"Avatar state cooldown: {avatar_cool:.1f}s")
        else:
            draw_text(10, 620, "Avatar state ready [C]")
        if air_timer > 0:
            draw_text(10, 590, f"AIR SHIELD: {air_timer:.1f}s")
        elif air_cool > 0:
            draw_text(10, 590, f"Air shield cooldown: {air_cool:.1f}s")
        else:
            draw_text(10, 590, "Air shield ready [1]")
    draw_buttons()

    # Swap buffers for smooth rendering (double buffering)
    glutSwapBuffers()


