def spawn_bullets(el, avatar=False):
    #one place that makes bullets, used by the mouse and by avatar state.
    #the last slot marks an avatar bullet, which kills whatever it touches
    rad = math.radians(angle) #angle aang is facing
    ax = -math.sin(rad) #x coord of where aang is facing
    ay = math.cos(rad) #y coord of where aang is facing
    if el == "earth":
        bullets.append([av_x + 60*ax, av_y + 60*ay, ax, ay, el, avatar])
    else:
        for k in range(3):
            off = 60 + k * 25 #spawn distance for each of the three streak segments
            bullets.append([av_x + off*ax, av_y + off*ay, ax, ay, el, avatar])

