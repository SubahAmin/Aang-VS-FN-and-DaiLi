def make_pillars():                                                                                       #look here pillars
    pillars = []
    target = random.randint(4, 8) #between 4 and 8 pillars each run
    tries = 0    #find valid position to place the pillar
    while len(pillars) < target and tries < 400:        #no. of pillar < target no. of pillar
        tries += 1
        r = random.randint(45, 75)
        x = random.randint(-780, 780)
        y = random.randint(-780, 780)
        if (x*x + y*y) ** 0.5 < 300 + r: #keep aang's spawn spot clear
            continue
        #leave a 200 wide gap between pillars so you can always walk between them
        if any(((x-px)**2 + (y-py)**2) ** 0.5 < r + pr + 200 for px, py, pr in pillars):    #distance between old pillar and new pillar
            continue
        pillars.append((x, y, r))        #pillar selected so add to pillar list
    return pillars

def in_pillar(x, y, r=0): #true if a point of size r overlaps any pillar
    for px, py, pr in PILLARS:
        if ((x-px)**2 + (y-py)**2) ** 0.5 < pr + r:
            return True
    return False

def push_out(x, y, r):
    #if the point ended up inside a pillar, slide it back out along the radius.
    #pushing out sideways is what makes you glide around the pillar instead of sticking
    for px, py, pr in PILLARS:
        dx, dy = x - px, y - py
        d = (dx*dx + dy*dy) ** 0.5
        if d < pr + r:
            if d < 1: #dead centre, pick any direction
                dx, dy, d = 1.0, 0.0, 1.0
            x = px + (dx/d) * (pr + r)
            y = py + (dy/d) * (pr + r)
    return x, y

def draw_pillars():
