def keyboardListener(key, x, y):
    """
    Handles keyboard inputs for player movement, gun rotation, camera updates, and cheat mode toggles.
    """
    global av_x, av_y, game_over, air_timer, water_cool, angle, air, water, fire, earth
    
    rad = math.radians(angle)
    ax=-math.sin(rad)
    ay=math.cos(rad)
    if key == b'w':  
        if not game_over: 
            av_x += 10 * ax
            av_y += 10 * ay

    # # Move backward (S key)
    if key == b's':
        if not game_over: 
            av_x -= 10 * ax
            av_y -= 10 * ay

    # # Rotate gun left (A key)
    if key == b'a':
        if not game_over: 
            angle=angle-10

    # # Rotate gun right (D key)
    if key == b'd':
        if not game_over: 
            angle=angle+10
            
    if key == b'1':
        air = True
        water, fire, earth = False, False, False
        air_timer = 10
        print("Air selected")
        
    if key == b'2':
        water = True
        air, fire, earth = False, False, False
        water_cool = 15
        print("Water selected")
    if key == b'3':
        earth = True
        water, fire, air = False, False, False
        print("Earth selected")
    if key == b'4':
        fire = True
        water, air, earth = False, False, False
        print("Fire selected")
        

def specialKeyListener(key, x, y):
    """
    Handles special key inputs (arrow keys) for adjusting the camera angle and height.
    """
    global camera_pos 
    x, y, z = camera_pos
    # Move camera up (UP arrow key)
    if key == GLUT_KEY_UP:
        z = z+10

    # # Move camera down (DOWN arrow key)
    if key == GLUT_KEY_DOWN:
        z = z-10
    # moving camera left (LEFT arrow key)
    if key == GLUT_KEY_LEFT:
        x -= 1  # Small angle decrement for smooth movement

    # moving camera right (RIGHT arrow key)
    if key == GLUT_KEY_RIGHT:
        x += 1  # Small angle increment for smooth movement

    camera_pos = (x, y, z)


def mouseListener(button, state, x, y):
    """
    Handles mouse inputs for firing bullets (left click) and toggling camera mode (right click).
    """
    global bullets, bullet_count

    if button == GLUT_LEFT_BUTTON and state == GLUT_DOWN and not game_over:
        rad = math.radians(angle) #angle aang is facing
        ax = -math.sin(rad) #x coord of where aang is facing
        ay = math.cos(rad) #y coord of where aang is facing
        element = "water" if water else "earth" if earth else "fire" if fire else None
        if element is None:
            return
        if element == "earth":
            bullets.append([av_x + 60*ax, av_y + 60*ay, ax, ay, element]) #spawn 60 units in front of Aang
        else: #for water and fire
            for k in range(3):
                #25 units spaced between bullets
                off = 60 + k * 25 #off is the spawn distance for each of the three streak segments: 60, 85, 110.
                bullets.append([av_x + off*ax, av_y + off*ay, ax, ay, element])
        bullet_count += 1
        # # Right mouse button toggles camera tracking mode
        # if button == GLUT_RIGHT_BUTTON and state == GLUT_DOWN:


def setupCamera():
    """
    Configures the camera's projection and view settings.
    Uses a perspective projection and positions the camera to look at the target.
    """
    glMatrixMode(GL_PROJECTION)  # Switch to projection matrix mode
    glLoadIdentity()  # Reset the projection matrix
    # Set up a perspective projection (field of view, aspect ratio, near clip, far clip)
    gluPerspective(fovY, 1.25, 0.1, 1500) # Think why aspect ration is 1.25?
    glMatrixMode(GL_MODELVIEW)  # Switch to model-view matrix mode
    glLoadIdentity()  # Reset the model-view matrix

    # Extract camera position and look-at target
    x, y, z = camera_pos
    # Position the camera and set its orientation
    gluLookAt(x, y, z,  # Camera position
              0, 0, 0,  # Look-at target
              0, 0, 1)  # Up vector (z-axis)


def idle():
    """
    Idle function that runs continuously:
    - Triggers screen redraw for real-time updates.
    """
    global av_x, av_y, air_timer, last_time, water, water_cool, enemy_positions, bullets, air, game_score, player_hp, enemy_fire, game_over, last_time
    
    #time elapsed since the last frame, in seconds
    now = time.perf_counter()
    if last_time == 0:
        last_time = now
    dt = now - last_time
    last_time = now
    if dt > 0.05:
        dt = 0.05
        
    if air_timer > 0:
        air_timer -= dt
        if air_timer <= 0:
            air = False
            print("Air shield expired")
    if water_cool > 0:
        water_cool -= dt
        if water_cool <= 0:
            water = False
            print("Water expired")
    
    bullet_speed = 120
    new_bullets = []
    for b in bullets:
        b[0] += b[2] * bullet_speed * dt #x coordinate of bullet being updated
        b[1] += b[3] * bullet_speed  * dt #y coordinate of bullet being updated
        if -600 <= b[0] <= 600 and -600 <= b[1] <= 600: #if bullet goes out of bounds of the arena
            new_bullets.append(b)
        
    bullets = new_bullets
    
    speed = 6
    patrol_speed = 24 #speed of dai li
    detect = 250
    
    #enemy movement
    for e in enemy_positions:
        dx = av_x - e["x"] #distance between aang x coord and enemy x coord
        dy = av_y - e["y"] #distance between aang y coord and enemy y coord
        d = (dx*dx + dy*dy) ** 0.5 #total detection range
        #e[immune] names the element that enemy resists,
        #(dx/d, dy/d) normalizes the vector to Aang — dividing by its own length gives a unit vector, same idea as ax, ay. Multiplying by speed steps that far toward him.
        if e["immune"] == "fire" or d < detect: #within range of detection 
            if d > 1:
                e["x"] += (dx/d) * speed * dt #enemy starts moving x and y coord towards aang x y coord
                e["y"] += (dy/d) * speed * dt
            e["cool"] -= dt #firing cooldown of enemies
            if e["cool"] <= 0 and 1 < d < 300 and not game_over:
                ux, uy = dx/d, dy/d
                if e["immune"] == "fire":
                    e["cool"] = 6.7
                    for k in range(4):
                        off = k * 35 #off is the spawn distance for each of the three streak segments: 0, 35, 70, 105
                        enemy_fire.append([e["x"] + ux*off, e["y"] + uy*off,
                                           ux, uy, "fire"])
                else:
                    e["cool"] = 10.0
                    enemy_fire.append([e["x"], e["y"], ux, uy, "earth"])
        else:
            if e["steps"] <= 0:
                e["hx"] = random.choice((-1.0, 1.0)) #e["hx"] is the patrol heading — +1.0 or -1.0, meaning right or left along X.
                e["steps"] = random.uniform(3.3, 10.0)
            e["x"] += e["hx"] * patrol_speed *dt
            e["steps"] -= dt #steps is a countdown. When it expires, pick a fresh random direction and a fresh duration
            if not -550 <= e["x"] <= 550: #boundary of arena for enemy
                e["hx"] = -e["hx"]
                e["x"] = max(-550, min(550, e["x"]))
    
    
    #enemy bullet movement
    fire_speed = 90
    earth_speed = 54
    aang_box = (av_x - 35, av_y - 35, 70, 70) #coordinate of aang
    surviving_fire = []
    for f in enemy_fire:
        v = fire_speed if f[4] == "fire" else earth_speed #selects speed of bullet depending on enemy
        half = 7 if f[4] == "fire" else 15
        f[0] += f[2] * v *dt #fire x coordinate being updated
        f[1] += f[3] * v * dt#fire y coordinate being updated
        if not (-600 <= f[0] <= 600 and -600 <= f[1] <= 600):
            continue
        if has_collided((f[0] - half, f[1] - half, half*2, half*2), aang_box):
            if air:
                print("Air shield deflected damage") #for element air selected, no damage is done
            else: #damage done by others when not air selected
                player_hp -= 2
                print("Aang hit! HP:", player_hp)
                if player_hp <= 0 and not game_over:
                    player_hp = 0
                    game_over = True
                    print("Game over")
            continue
        surviving_fire.append(f)
    enemy_fire = surviving_fire
    
    
    # bullet vs enemy
    surviving_bullets = []
    for b in bullets:
        half = 17 if b[4] == "earth" else 6 #half is half width of projectile hitbox as point calculated from centre
        bullet_box = (b[0] - half, b[1] - half, half*2, half*2)
        target = None
        best = None
        for e in enemy_positions:
            enemy_box = (e["x"] - 80, e["y"] - 80, 160, 160)
            if has_collided(bullet_box, enemy_box):
                d = (b[0] - e["x"])**2 + (b[1] - e["y"])**2
                if best is None or d < best:
                    best = d
                    target = e
        if target is None:
            surviving_bullets.append(b)
            continue
        if b[4] == target["immune"]:
            print("Immune")
        else:
            dmg = DAMAGE.get((target["immune"], b[4]), 1)
            target["hp"] -= dmg
            print("Hit for", dmg, "- enemy HP:", target["hp"])
            if target["hp"] <= 0:
                print("Enemy down!")
                game_score += 1
                target["x"], target["y"] = respawn_position()
                target["hp"] = target["maxhp"]
                target["steps"] = 0
    bullets = surviving_bullets
    
    # Ensure the screen updates with the latest changes
    glutPostRedisplay()


def showScreen():
    """
    Display function to render the game scene:
    - Clears the screen and sets up the camera.
    - Draws everything of the screen
    """
    # Clear color and depth buffers
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    glLoadIdentity()  # Reset modelview matrix
    glViewport(0, 0, 1000, 800)  # Set viewport size

    setupCamera()  # Configure camera perspective

    # Draw a random points
    glPointSize(20)
    glBegin(GL_POINTS)
    glVertex3f(-GRID_LENGTH, GRID_LENGTH, 0)
    glEnd()

    # Draw the grid (game floor)
    glBegin(GL_QUADS)
    
    glColor3f(0.4, 0.2, 0.1)
    glVertex3f(-600, 600, 0)
    glVertex3f(-600, -600, 0)
    glVertex3f(600, -600, 0)
    glVertex3f(600, 600, 0)
    
    glColor3f(0.9, 0.6, 0.5)
    for i in range (-600,600,60):
        glVertex3f(i, 600, 0)
        glVertex3f(i, -600, 0)
        glVertex3f(i+50, -600, 0)
        glVertex3f(i+50, 600, 0)
  
    glEnd()

    # Display game info text at a fixed screen position
    draw_text(10, 770, f"HP: {player_hp}")
    draw_text(10, 740, f"Score: {game_score}")
    draw_shapes()

    # Swap buffers for smooth rendering (double buffering)
    glutSwapBuffers()


# Main function to set up OpenGL window and loop
def main():
    global enemy_positions
    enemy_positions = [{"x": x, "y": y,
                 "immune": "fire" if i < 4 else "earth",
                 "hx": 0.0, "hy": 0.0, "steps": 0, "cool": 0,
                 "hp": 10, "maxhp": 10}
                for i, (x, y) in enumerate(spaced_positions(6))]
    glutInit()
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH)  # Double buffering, RGB color, depth test
    glutInitWindowSize(1000, 800)  # Window size
    glutInitWindowPosition(0, 0)  # Window position
    wind = glutCreateWindow(b"3D OpenGL Intro")  # Create the window

    glutDisplayFunc(showScreen)  # Register display function
    glutKeyboardFunc(keyboardListener)  # Register keyboard listener
    glutSpecialFunc(specialKeyListener)
    glutMouseFunc(mouseListener)
    glutIdleFunc(idle)  # Register the idle function to move the bullet automatically

    glutMainLoop()  # Enter the GLUT main loop

if __name__ == "__main__":
    main()
